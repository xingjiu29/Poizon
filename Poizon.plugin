#!name=得物去广告
#!desc=移除「我的」页创作中心/钱包/卖家入口/省钱神券/工具箱、「探索」页鉴别服务/玩一玩/买卖闲置/得物月付、「得物」页顶部玉龙出场tab/灵感tab/视频tab、「购买」页顶部11.11tab、搜索词联想、猜你想搜、热搜榜、评价页顶部去晒单、搜索页顶部视频tab、订单页热销/回购提示气泡及为你推荐
#!author=杏九
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/6f/9d/bc/6f9dbc7d-695e-f1ba-230d-b6f34b50492d/AppIcon-0-0-1x_U007emarketing-0-8-0-85-220.png/512x512bb.jpg
#!loon_version = 3.5.3(1014)
#!tag=去广告
[Rule]
DOMAIN-SUFFIX,dewu.com,PROXY
DOMAIN-SUFFIX,poizon.com,PROXY
[Rewrite]
^https?:\/\/app\.dewu\.com\/api\/v1\/app\/advertisement\/ - reject-dict
^https?:\/\/app\.dewu\.com\/hacking-newbie\/v1\/common\/home\/new-activate\/adv\/layer - reject-dict
^https?:\/\/app\.dewu\.com\/api\/v1\/app\/userConfig-biz\/popUpWindowApi\/queryPopUpWindows - reject-dict
^https?:\/\/app\.dewu\.com\/hacking-growth-app\/v1\/common\/pop\/all-config - reject-dict
^https?:\/\/app\.dewu\.com\/hacking-activity\/v1\/landing-page\/adv-bar - reject-dict
^https?:\/\/app\.dewu\.com\/sns-act\/v1\/h5\/slidebar\/home - reject-dict
[Script]
http-response ^https?:\/\/(?:[a-z0-9-]+\.)*(?:dewu|poizon)\.com\/(identify-discovery\/v1\/discovery\/index|api\/v1\/app\/index\/ice\/purchase-tab\/list|sns-rec\/v1\/(search\/word-skip\/new-list|du-tab)|api\/v1\/app\/biz-aggregate\/me\/user-index|api\/v1\/app\/search\/lexicon\/v3\/background_words) script-path=https://raw.githubusercontent.com/xingjiu29/Poizon/main/Poizon.js?v=2, requires-body=true, timeout=30
[MitM]
hostname = %APPEND% app.dewu.com
