#!name=得物去广告
#!desc=去掉「我的」页的钱包/卖家入口/省钱神券/工具箱，以及「探索」页的鉴别服务/玩一玩/买卖闲置/得物月付
#!author=杏九
#!loon_version = 3.5.3(1014)
#!tag=去广告
[Script]
http-response ^https:\/\/app\.dewu\.com\/(api\/v1\/app\/biz-aggregate\/me\/user-index|identify-discovery\/v1\/discovery\/index) script-path=https://raw.githubusercontent.com/xingjiu29/Poizon/refs/heads/main/Poizon.js?v=1, requires-body=true, timeout=30
[MitM]
hostname = %APPEND% app.dewu.com
